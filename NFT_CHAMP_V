    // GET

    function getMyAllNFTs() public view returns(structNFT[] memory) {
        uint256 count = 0;
        
        // Запоминаем сколько всего nft у юзера
        for (uint256 i = 0; i < unicueNFT; i++) {
            if (userNFTs[msg.sender][i].amount > 0) {
                count++;
            }
        }
        // Создаём массив с тем количеством ячеек сколько всего нфт у юзера, в который будем класть нфт
        structNFT[] memory NFTs = new structNFT[](count);

        // По этому индексу кладём в массив найденные нфт
        uint256 index = 0;

        for (uint256 i = 0; i < unicueNFT; i++) {
            if (userNFTs[msg.sender][i].amount > 0) {
                NFTs[index] = userNFTs[msg.sender][i]; // Кладём нфт в массив, если они существуют
                index++;
            }
        }

        return NFTs;
    }

    function getAllStoreNFTs() public view returns (structNFTsInStore[] memory) {
        uint256 count = 0;

        for (uint256 i = 0; i < indexNFTInStore; i++) {
            if (storeNFT[i].amount > 0) {
                count++;
            }
        }

        structNFTsInStore[] memory result = new structNFTsInStore[](count);
        uint256 index = 0;

        for (uint256 i = 0; i < indexNFTInStore; i++) {
            if (storeNFT[i].amount > 0) {
                result[index] = storeNFT[i];
                index++;
            }
        }

        return result;
    }

    
    // SET NFT

    function setNFT(
        string memory _name,
        string memory _description,
        string memory _imgPath,
        uint256 _amount
    ) public onlyOwner{

        require(_amount > 0, "amount must be > 0");

        _mint(msg.sender, unicueNFT, _amount, ""); // Создание nft в системе. Последний параметр принимает комментарий

        // Добавление в мапинг юзера
        userNFTs[msg.sender][unicueNFT] = structNFT(
            unicueNFT,
            _name,
            _description,
            _imgPath,
            _amount,
            block.timestamp
        );

        // Добавление в мапинг юзера
        allNFTs[unicueNFT] = structNFT(
            unicueNFT,
            _name,
            _description,
            _imgPath,
            _amount,
            block.timestamp
        );

        unicueNFT++;
    }

    // SET STORE

    function setNFTInStore(uint256 _id, uint256 _amount, uint256 _price) public  { 

        uint256 userAmount = userNFTs[msg.sender][_id].amount;

        require(_amount <= userAmount, "you don't have this nft");

        storeNFT[indexNFTInStore] = structNFTsInStore(
            _id,
            msg.sender,
            _amount,
            _price // цена указывается за одну штуку
        );


        if (_amount == userAmount) {
            delete userNFTs[msg.sender][_id];
        } else {
            userNFTs[msg.sender][_id].amount -= _amount;
        }


        indexNFTInStore++;
        
    }

    function buyNFT(uint256 _index, uint256 _amount) public payable {

        uint256 amountNFTInStore = storeNFT[_index].amount;
        uint256 priceNFT = storeNFT[_index].price * _amount;
        address ownerNFTInStore = storeNFT[_index].owner;
        uint256 idNFT = storeNFT[_index].id;

        uint256 balance = balanceOf(msg.sender);

        require(_amount <= amountNFTInStore, "your amount is very big for this nft in store");
        require(balance >= priceNFT, "you don't have enough PROFI for purchase this nft");

        _transfer(msg.sender, ownerNFTInStore, priceNFT);

        _safeTransferFrom(

            ownerNFTInStore,
            msg.sender,
            idNFT,
            _amount,
            ""
        );

        if (amountNFTInStore == _amount) {
            delete storeNFT[_index];
        } else {
            storeNFT[_index].amount -= _amount;
        }

        if (userNFTs[msg.sender][idNFT].amount > 0) {
            userNFTs[msg.sender][idNFT].amount += _amount;
        } else {
            userNFTs[msg.sender][idNFT] = allNFTs[idNFT];
            userNFTs[msg.sender][idNFT].amount = _amount;
        } 

    }

