        user[0x4B20993Bc481177ec7E8f571ceCaE8A9e22C02db] = structUser("Max", "PROFI4B22026", 0);
        ERC20._mint(0x4B20993Bc481177ec7E8f571ceCaE8A9e22C02db, 300_000 * 12);

        user[0x78731D3Ca6b7E34aC0F824c42a7cC18A495cabaB] = structUser("Jack", "PROFI7872026", 0);
