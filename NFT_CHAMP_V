    constructor() ERC20("Professional", "PROFI") ERC1155("./images/") {
        owner = msg.sender;

        ERC20._mint(owner, 100_000 * 12);
        user[msg.sender] = structUser("owner", "PROFI5B32026", 0);

        setNFT("NFT0", "deskNFT0", "imgPath", 10);
        setNFT("NFT01", "deskNFT01", "imgPath", 10);
        setNFT("NFT02", "deskNFT02", "imgPath", 10);
        setNFT("NFT03", "deskNFT03", "imgPath", 10);

        setNFTInStore(0, 5, 100); // id, amount, price
        setNFTInStore(1, 5, 228);

        setColl("myColl0", "deskColl0");
        setColl("myColl01", "deskColl01");
        setColl("myColl02", "deskColl02");

        // remix
        user[0xAb8483F64d9C6d1EcF9b849Ae677dD3315835cb2] = structUser("Tom", "PROFIAb82026", 0);
