pragma solidity ^0.8.28;

import "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import "@openzeppelin/contracts/token/ERC1155/ERC1155.sol";

contract Contract is ERC20, ERC1155 {

    // SOMETHING

    address owner;

    uint256 unicueNFT;
    uint256 unicueColl;

    uint256 indexNFTInStore;
    uint256 indexCollInAuction;

    // STRUCT

    struct structUser {
        string name;
        string referalCode;
        uint256 discont;
    }

    struct structNFT {
        uint256 id;
        string name;
        string imgPath;
        string description;
        uint256 amount;
        uint256 createDate;
        bool inColl;
        string nameColl;
    }

    struct structNFTInColl {
        uint256 id;
        uint256 amount;
    }

    struct structColl {
        uint256 id;
        string name;
        string description;
        structNFTInColl[] NFTInColl;
        bool inAuction;
        bool existe;
        uint256 createDate;
    }

    struct structNFTInStore {
        address owner;
        uint256 id;
        uint256 amount;
        uint256 price;
    }

    struct structAuction {
        uint256 id;
        uint256 idColl;
        uint256 timeStart;
        uint256 timeEnd;
        uint256 minBet;
        uint256 maxBet;
    }

    struct structBet {
        address ownerBet;
        uint256 priceBet;      
    }


    // MAPPING

    mapping(address => structUser) public user;

    mapping(address => mapping (uint256 => structNFT)) public userNFT;
    mapping(address => mapping (uint256 => structColl)) public userColl;

    mapping(uint256 => structNFT) public allNFT;

    mapping(uint256 => structNFTInStore) public storeNFT;

    mapping(uint256 => structAuction) public auctionColl;
    mapping(uint256 => structBet) public betAuction; // index auc => currentBet


    // MODIFIER

    modifier onlyOwner() {
        require(msg.sender == owner, "You are not owner");
        _;
    }

    // GET

    function getAllNFT() public view returns(structNFT[] memory) {
        uint256 count;

        for (uint256 i = 0; i < unicueNFT; i++) {
            if (userNFT[msg.sender][i].amount > 0) {
                count++;
            }
        }

        structNFT[] memory NFTs = new structNFT[](count);
        uint256 index;

        for (uint256 i = 0; i < unicueNFT; i++) {
            if (userNFT[msg.sender][i].amount > 0) {
                NFTs[index] = userNFT[msg.sender][i];
                index++;
            }
        }

        return NFTs;
    }

    function getAllColl() public view returns(structColl[] memory) {

        uint256 count;

        for (uint256 i = 0; i < unicueColl; i++) {
            if (userColl[msg.sender][i].existe) {
                count++;
            }
        }

        structColl[] memory colls = new structColl[](count);
        uint256 index;

        for (uint256 i = 0; i < unicueColl; i++) {
            if (userColl[msg.sender][i].existe) {
                colls[index] = userColl[msg.sender][i];
                index++;
            }
        }

        return colls;

    }


    function getAllNFTInStore() public view returns(structNFTInStore[] memory) {

        uint256 count;

        for (uint256 i = 0; i < indexNFTInStore; i++) {
            if (storeNFT[i].amount > 0) {
                count++;
            }
        }

        structNFTInStore[] memory NFTs = new structNFTInStore[](count);
        uint256 index;

        for (uint256 i = 0; i < indexNFTInStore; i++) {
            if (storeNFT[i].amount > 0) {
                NFTs[index] = storeNFT[i];
                index++;
            }
        }

        return NFTs;

    }


    function getAllAuctions() public view returns(structAuction[] memory) {

        uint256 count;

        for (uint256 i = 0; i < indexCollInAuction; i++) {
            if (auctionColl[i].timeStart > 0) {
                count++;
            }
        }

        structAuction[] memory auctions = new structAuction[](count);
        uint256 index;

        for (uint256 i = 0; i < indexCollInAuction; i++) {
            if (auctionColl[i].timeStart > 0) {
                auctions[index] = auctionColl[i];
                index++;
            }
        }

        return auctions;

    }

    // SET
    function setNFT(
        string memory _name,
        string memory _description,
        string memory _imgPath,
        uint256 _amount
    ) public onlyOwner {

        require(_amount > 0, "amount can't be < 0" );

        ERC1155._mint(msg.sender, unicueNFT, _amount, "");

        userNFT[msg.sender][unicueNFT] = structNFT(
            unicueNFT,
            _name,
            _imgPath,
            _description,
            _amount,
            block.timestamp,
            false,
            ""
        );

        
        allNFT[unicueNFT] = structNFT(
            unicueNFT,
            _name,
            _imgPath,
            _description,
            _amount,
            block.timestamp,
            false,
            ""
        );

        unicueNFT++;

    }

    function setNFTInStore(uint256 _id, uint256 _amount, uint256 _price) public {
        
        uint256 userAmount = userNFT[msg.sender][_id].amount;

        require(_amount <= userAmount, "you dont have enough amount nft");

        // add in mapping
        storeNFT[indexNFTInStore] = structNFTInStore (
            msg.sender,
            _id,
            _amount,
            _price
        );

        // delete in user
        if (userAmount == _amount) {
            delete userNFT[msg.sender][_id];
        } else {
            userNFT[msg.sender][_id].amount -= _amount;
        }

        indexNFTInStore++;
    }

    function buyNFT(uint256 _index, uint256 _amount) public payable {
        
        uint256 amountInStore = storeNFT[_index].amount;
        address ownerNFT = storeNFT[_index].owner;
        uint256 price = storeNFT[_index].price * _amount;
        uint256 id = storeNFT[_index].id;

        require(amountInStore >= _amount, "in store not enough amount nft");

        _transfer(msg.sender, ownerNFT, price);

        // add in mapping user
        if (userNFT[msg.sender][id].amount > 0) {
            userNFT[msg.sender][id].amount += _amount;
        } else {
            userNFT[msg.sender][id] = allNFT[id];
            userNFT[msg.sender][id].amount = _amount;
        }

        // delete in store

        if (amountInStore == _amount) {
            delete storeNFT[_index];
        } else {
            storeNFT[_index].amount -= _amount;
        }

    }

    function setColl(
        string memory _name,
        string memory  _description
    ) public onlyOwner {

        userColl[msg.sender][unicueColl] = structColl(
            unicueColl,
            _name,
            _description,
            new structNFTInColl[](0),
            false,
            true,
            block.timestamp
        );

        unicueColl++;
    }

    function setNFTInColl(uint256 _idNFT, uint256 _idColl) public onlyOwner {

        require(userColl[msg.sender][_idColl].existe, "you dont have this coll");
        require(userColl[msg.sender][_idColl].inAuction == false, "this coll in auction");

        uint256 amountNFT = userNFT[msg.sender][_idNFT].amount;

        userColl[msg.sender][_idColl].NFTInColl.push(structNFTInColl(
            _idNFT,
            amountNFT
        ));

        userNFT[msg.sender][_idNFT].inColl = true;
        userNFT[msg.sender][_idNFT].nameColl = userColl[msg.sender][_idColl].name;

    }

    function setAuction(uint256 _idColl, uint256 _minBet, uint256 _maxBet, uint256 _timeEnd) public {

        require(userColl[msg.sender][_idColl].existe, "you dont have this coll");
        require(userColl[msg.sender][_idColl].inAuction == false, "this coll in auction");

        auctionColl[indexCollInAuction] = structAuction(
            indexCollInAuction,
            _idColl,
            block.timestamp,
            block.timestamp + _timeEnd,
            _minBet,
            _maxBet
        );

        userColl[msg.sender][_idColl].inAuction == true;

        indexCollInAuction++;

    }

    // setBEt
    function setBet(uint256 _indexAuction, uint256 _bet) public {

        require(auctionColl[_indexAuction].timeStart > 0, " does not this auction");
        require(balanceOf(msg.sender) >= _bet, "you dont have enough coin");
        require(betAuction[_indexAuction].priceBet < _bet, "current bet > your bet");
        require(auctionColl[_indexAuction].minBet <= _bet, " your bet < min bet");
        require(auctionColl[_indexAuction].maxBet >= _bet, "your bet is very big");

        betAuction[_indexAuction] = structBet(
            msg.sender,
            _bet
        );
    }

    // endAuction
    
